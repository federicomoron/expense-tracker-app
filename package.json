{
  "name": "control-de-gastos",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "start:prod": "serve -s dist/control-de-gastos/browser -l 8080",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "check": "yarn lint && yarn prettier:check",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "format:all": "npm run format && npm run lint:fix",
    "postinstall": "husky install",
    "test:watch": "ng test --watch"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.1.1",
    "@angular/cdk": "20.1.1",
    "@angular/common": "^20.1.1",
    "@angular/compiler": "^20.1.1",
    "@angular/core": "^20.1.1",
    "@angular/flex-layout": "^15.0.0-beta.42",
    "@angular/forms": "^20.1.1",
    "@angular/material": "20.1.1",
    "@angular/platform-browser": "^20.1.1",
    "@angular/platform-browser-dynamic": "^20.1.1",
    "@angular/pwa": "^20.1.0",
    "@angular/router": "^20.1.1",
    "@angular/service-worker": "^20.1.1",
    "@jsverse/transloco": "^7.6.1",
    "@jsverse/transloco-locale": "^7.0.1",
    "@jsverse/transloco-messageformat": "^7.0.1",
    "@ngneat/transloco": "^6.0.4",
    "@ngneat/transloco-locale": "^5.1.2",
    "@ngneat/transloco-messageformat": "^5.0.0",
    "@ngx-translate/core": "^16.0.4",
    "@ngx-translate/http-loader": "^16.0.1",
    "date-fns": "^2.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1",
    "zod": "3.25.75",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "20",
    "@angular-eslint/eslint-plugin": "20",
    "@angular-eslint/eslint-plugin-template": "20",
    "@angular-eslint/schematics": "20",
    "@angular-eslint/template-parser": "20",
    "@angular/build": "^20.1.1",
    "@angular/cli": "^20.1.1",
    "@angular/compiler-cli": "^20.1.1",
    "@types/jasmine": "~5.1.0",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@typescript-eslint/types": "8.31.0",
    "@typescript-eslint/utils": "^8.32.1",
    "angular-eslint": "^19.3.0",
    "brace-expansion": "^4.0.0",
    "chokidar": "^4.0.0",
    "eslint": "^8.31.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-import-resolver-typescript": "^4.3.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.6",
    "husky": "^9.1.7",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
